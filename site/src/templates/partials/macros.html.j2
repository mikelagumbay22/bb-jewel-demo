{%- macro media(img, sizes, cls="", eager=false, extra="") -%}
<div class="media {{ cls }}"{% if img.focus %} style="--focus: {{ img.focus }}"{% endif %}{{ extra | safe }}>
  {%- if img.illustrative %}<span class="ph-badge image-badge">{{ c.meta.image_badge }}</span>{% endif %}
  <img src="{{ img.resolved.src }}" srcset="{{ img.resolved.srcset }}" sizes="{{ sizes }}" width="{{ img.resolved.width }}" height="{{ img.resolved.height }}" alt="{{ img.alt }}" {% if eager %}fetchpriority="high"{% else %}loading="lazy"{% endif %} decoding="async">
</div>
{%- endmacro -%}







{%- macro disabled_note(id) -%}
<p class="form-disabled-note" id="{{ id }}">{{ icon("info") }}<span>This form is disabled in this demo. Please call <a href="tel:{{ b.phone_e164 }}">{{ b.phone_display }}</a> to book or ask a question.</span></p>
{%- endmacro -%}

{%- macro steps_list(items) -%}
<ol class="road-steps">
  {%- for st in items %}
  <li class="reveal" style="--d: {{ loop.index0 * 0.1 }}s"><span class="road-steps__n">{{ loop.index }}</span><h3>{{ st.title }}</h3><p>{{ st.text }}</p></li>
  {%- endfor %}
</ol>
{%- endmacro -%}


{%- macro domain_bar() -%}
<div class="browser" role="img" aria-label="Example browser address bar showing bbjewel.ca or bbjewel.com (example addresses only)">
  <span class="browser__dots" aria-hidden="true"><i></i><i></i><i></i></span>
  <span class="browser__url" aria-hidden="true">bbjewel<span class="tld">.ca</span></span>
</div>
{%- endmacro -%}

{%- macro package_panel() -%}
{%- set pk = c.package %}
<section class="package" aria-labelledby="package-title">
  <div class="container package__inner reveal">
    <p class="package__tag">{{ pk.label }}</p>
    <h2 id="package-title" class="package__title">{{ pk.heading }}</h2>
    <p class="package__intro">{{ pk.intro }}</p>
    <div class="package__grid">
      <ol class="package__list">{%- for f in pk.features %}<li><span class="package__n">{{ f.n }}</span>{{ f.text }}</li>{% endfor %}</ol>
      <div class="package__domain">{{ domain_bar() }}<p><strong>{{ pk.domain_line }}</strong></p><p class="package__note">{{ pk.domain_note }}</p></div>
    </div>
  </div>
</section>
{%- endmacro -%}


{%- macro contact_buttons(cls="") -%}
<div class="btn-row {{ cls }}">
  <a class="btn btn--primary btn--lg" href="tel:{{ b.phone_e164 }}">{{ icon("phone") }}Call {{ b.phone_display }}</a>
  <a class="btn btn--gold btn--lg" href="{{ directions_url }}" target="_blank" rel="noopener">{{ icon("pin") }}Get directions<span class="visually-hidden"> (opens Google Maps in a new tab)</span></a>
</div>
{%- endmacro -%}

{%- macro review_button(cls="btn--ghost") -%}
<a class="btn {{ cls }}" href="{{ reviews_url }}" target="_blank" rel="noopener">{{ icon("star") }}{{ c.reviews.leave_label }}<span class="visually-hidden"> (opens Google Maps in a new tab)</span></a>
{%- endmacro -%}

{%- macro rating_badge() -%}
<p class="rating"><span class="rating__stars" aria-hidden="true"><span style="--fill: {{ (b.rating | float) / 5 * 100 }}%">★★★★★</span>★★★★★</span><span><strong>{{ b.rating }}</strong> on Google from <strong>{{ b.review_count }}</strong> reviews</span></p>
{%- endmacro -%}


{%- macro sparkle_divider() -%}
<div class="spark-div" aria-hidden="true" data-sear><span></span><i></i><span></span></div>
{%- endmacro -%}

{%- macro gallery_card(it) -%}
<li class="gcard reveal" data-tilt>
  <div class="media media--wide">
    <img src="{{ it.image }}" srcset="{{ it.image_small }} 480w, {{ it.image }} 800w" sizes="(min-width: 1040px) 360px, (min-width: 640px) 46vw, 92vw" width="800" height="600" alt="{{ it.alt }}" loading="lazy" decoding="async">
    {%- if it.illustrative %}<span class="image-badge">{{ c.meta.image_badge }}</span>{% endif %}
  </div>
  <div class="gcard__body"><h3>{{ it.title }}</h3><p class="gcard__cat">{{ it.category }}</p><p>Styles and details: <mark class="ph-inline">{{ it.details }}</mark></p></div>
</li>
{%- endmacro -%}

{#- SIGNATURE: pinned scroll scene. Empty velvet bust -> chain strands + pendant fly in with sparkles -> crossfade to the finished necklace. Layers are aligned crops of one edited scene. -#}
{%- macro necklace_scene() -%}
<section class="sig" data-sig aria-labelledby="sig-title">
  <div class="sig__sticky">
    <div class="sig__stage">
      <picture class="sig__layer sig__base"><source media="(max-width: 699px)" srcset="img/sig/base-tall-900.webp"><img src="img/sig/base-wide-1600.webp" srcset="img/sig/base-wide-900.webp 900w, img/sig/base-wide-1600.webp 1600w" sizes="(max-width: 699px) 100vw, 1600px" width="1600" height="1216" alt="" decoding="async" loading="lazy"></picture>
      <picture class="sig__layer sig__final"><source media="(max-width: 699px)" srcset="img/sig/final-tall-900.webp"><img src="img/sig/final-wide-1600.webp" srcset="img/sig/final-wide-900.webp 900w, img/sig/final-wide-1600.webp 1600w" sizes="(max-width: 699px) 100vw, 1600px" width="1600" height="1216" alt="A gold necklace with an ornate pendant on a velvet display bust" decoding="async" loading="lazy"></picture>
      <img class="sig__part sig__chain sig__chain--l" src="img/sig/chain.webp" width="325" height="480" alt="" loading="lazy" decoding="async">
      <img class="sig__part sig__chain sig__chain--r" src="img/sig/chain.webp" width="325" height="480" alt="" loading="lazy" decoding="async">
      <img class="sig__part sig__pendant" src="img/sig/pendant.webp" width="250" height="480" alt="" loading="lazy" decoding="async">
      {%- for s in [(41, 30, 0.3), (58, 34, 0.45), (50, 58, 0.62), (46, 70, 0.8), (54, 44, 0.9)] %}
      <img class="sig__spark" src="img/sig/sparkle.webp" width="291" height="330" alt="" loading="lazy" decoding="async" style="--x:{{ s[0] }}%; --y:{{ s[1] }}%" data-at="{{ s[2] }}">
      {%- endfor %}
    </div>
    <span class="image-badge sig__badge">{{ c.meta.image_badge }}</span>
    <div class="sig__copy">
      <p class="eyebrow">Gold jewellery · Malton</p>
      <h2 id="sig-title">Piece by piece, <em>made to shine</em></h2>
      <p>Chains, pendants, bangles and more. Come in and see the collection on Airport Rd.</p>
      <a class="btn btn--gold" href="{{ page_href.collections }}">{{ icon("star") }}See collections</a>
    </div>
    <ol class="sig__steps" aria-hidden="true"><li>Chain</li><li>Pendant</li><li>Finished</li></ol>
  </div>
</section>
{%- endmacro -%}

{%- macro appointment_form() -%}
<form class="demo-form reveal reveal-r" aria-labelledby="appt-title" aria-describedby="appt-note" onsubmit="return false">
  <fieldset disabled>
    <legend class="visually-hidden">Piercing appointment request (disabled in this demo)</legend>
    <div class="f-row">
      <div><label for="a-name">Name</label><input id="a-name" type="text" autocomplete="name"></div>
      <div><label for="a-phone">Phone</label><input id="a-phone" type="tel" autocomplete="tel" placeholder="(905) 555-0123"></div>
    </div>
    <label for="a-service">Service</label>
    <select id="a-service"><option>Ear lobe piercing</option><option>Upper ear piercing</option><option>Nose piercing</option><option>Other (tell us below)</option></select>
    <div class="f-row">
      <div><label for="a-date">Preferred date</label><input id="a-date" type="date"></div>
      <div><label for="a-time">Preferred time</label><input id="a-time" type="time"></div>
    </div>
    <label for="a-msg">Message</label><textarea id="a-msg" rows="4" placeholder="Anything we should know?"></textarea>
    <button class="btn btn--gold" type="submit">{{ icon("calendar") }}Request appointment</button>
  </fieldset>
  <p class="form-note">Disabled in this demo: nothing is sent.</p>
</form>
{%- endmacro -%}
